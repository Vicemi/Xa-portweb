---
import XaGameView from '../components/XaGame.tsx';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>XA Contra los Cuatreros Galácticos</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <XaGameView client:only="react" />
  </body>
</html>

<style is:global>
  html, body { margin: 0; height: 100%; background: #000; overflow: hidden; }
  .xa-stage { position: fixed; inset: 0; background: #000; }
  .xa-canvas { display: block; width: 100%; height: 100%; outline: none; touch-action: none; }
</style>
