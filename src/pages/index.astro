---
import XaGameView from '../components/XaGame.tsx';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>XA Contra los Cuatreros Galácticos</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <XaGameView client:only="react" />
  </body>
</html>

<style is:global>
  html, body { margin: 0; height: 100%; background: #000; overflow: hidden; overscroll-behavior: none; }
  /* dvh follows the mobile browser bars; safe-area keeps controls clear of notches */
  .xa-stage { position: fixed; inset: 0; height: 100vh; height: 100dvh; background: #000; }
  .xa-stage:fullscreen { width: 100vw; height: 100vh; }
  .xa-canvas { display: block; width: 100%; height: 100%; outline: none; touch-action: none; }

  /* --- mobile: rotate prompt --- */
  .xa-rotate {
    position: fixed; inset: 0; display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.92); color: #e8f0e0; z-index: 10; text-align: center;
  }
  .xa-rotate-inner { font: bold 1.4rem/1.5 system-ui, sans-serif; display: flex; flex-direction: column; gap: 1rem; }
  .xa-rotate-icon { font-size: 3rem; animation: xa-spin 2s ease-in-out infinite; }
  @keyframes xa-spin { 0%, 20% { transform: rotate(0deg); } 70%, 100% { transform: rotate(90deg); } }

  /* --- mobile: touch controls (src/components/TouchControls.tsx) --- */
  .xa-touch {
    position: fixed; inset: 0; z-index: 5; touch-action: none;
    user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; -webkit-tap-highlight-color: transparent;
  }
  /* floating stick: ring at the touch origin + knob under the finger */
  .xa-stick-ring, .xa-stick-knob { position: absolute; border-radius: 50%; transform: translate(-50%, -50%); pointer-events: none; }
  .xa-stick-ring {
    width: 124px; height: 124px;
    border: 2px solid rgba(255,255,255,0.45); background: rgba(255,255,255,0.08);
  }
  .xa-stick-knob {
    width: 58px; height: 58px;
    background: rgba(255,255,255,0.35); border: 2px solid rgba(255,255,255,0.7);
    box-shadow: 0 2px 8px rgba(0,0,0,0.35);
  }
  .xa-stick-hint {
    position: absolute; pointer-events: none; border-radius: 50%;
    left: calc(1.2rem + env(safe-area-inset-left)); bottom: calc(1.2rem + env(safe-area-inset-bottom));
    width: 7rem; height: 7rem; display: flex; align-items: center; justify-content: center;
    border: 2px dashed rgba(255,255,255,0.22); color: rgba(255,255,255,0.4);
    font: bold 1rem system-ui, sans-serif; letter-spacing: 0.4rem;
  }
  /* action buttons: big, well separated, slightly see-through so the game stays visible */
  .xa-act {
    position: absolute; pointer-events: none; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    border: 2px solid rgba(255,255,255,0.55); background: rgba(255,255,255,0.13);
    color: rgba(255,255,255,0.92); font: bold 0.85rem system-ui, sans-serif;
    text-shadow: 0 1px 2px rgba(0,0,0,0.7); transition: transform 60ms, background 60ms;
  }
  .xa-act.is-down { background: rgba(255,255,255,0.38); transform: scale(0.94); }
  .xa-act-jump {
    width: 6rem; height: 6rem;
    right: calc(1.2rem + env(safe-area-inset-right)); bottom: calc(1.4rem + env(safe-area-inset-bottom));
  }
  .xa-act-fire {
    width: 4.8rem; height: 4.8rem;
    right: calc(9rem + env(safe-area-inset-right)); bottom: calc(1.1rem + env(safe-area-inset-bottom));
  }
  .xa-pause-btn {
    position: absolute; top: calc(0.6rem + env(safe-area-inset-top)); right: calc(0.6rem + env(safe-area-inset-right));
    width: 2.6rem; height: 2.6rem; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    border: 2px solid rgba(255,255,255,0.5); background: rgba(0,0,0,0.25); color: rgba(255,255,255,0.9);
    font: bold 0.8rem system-ui, sans-serif;
  }
  /* short landscape phones: keep the buttons big enough to hit but clear of the play area */
  @media (max-height: 420px) {
    .xa-act-jump { width: 5rem; height: 5rem; }
    .xa-act-fire { width: 4rem; height: 4rem; right: calc(7.6rem + env(safe-area-inset-right)); }
    .xa-stick-hint { width: 5.5rem; height: 5.5rem; }
  }
</style>
