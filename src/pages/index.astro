---
import XaGameView from '../components/XaGame.tsx';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>XA Contra los Cuatreros Galácticos</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <XaGameView client:only="react" />
  </body>
</html>

<style is:global>
  html, body { margin: 0; height: 100%; background: #000; overflow: hidden; overscroll-behavior: none; }
  /* dvh follows the mobile browser bars; safe-area keeps controls clear of notches */
  .xa-stage { position: fixed; inset: 0; height: 100vh; height: 100dvh; background: #000; }
  .xa-stage:fullscreen { width: 100vw; height: 100vh; }
  .xa-canvas { display: block; width: 100%; height: 100%; outline: none; touch-action: none; }

  /* --- mobile: rotate prompt --- */
  .xa-rotate {
    position: fixed; inset: 0; display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.92); color: #e8f0e0; z-index: 10; text-align: center;
  }
  .xa-rotate-inner { font: bold 1.4rem/1.5 system-ui, sans-serif; display: flex; flex-direction: column; gap: 1rem; }
  .xa-rotate-icon { font-size: 3rem; animation: xa-spin 2s ease-in-out infinite; }
  @keyframes xa-spin { 0%, 20% { transform: rotate(0deg); } 70%, 100% { transform: rotate(90deg); } }

  /* --- mobile: transparent virtual controls --- */
  .xa-controls { position: fixed; inset: 0; pointer-events: none; z-index: 5; }
  .xa-controls .xa-btn {
    pointer-events: auto; position: absolute; display: flex; align-items: center; justify-content: center;
    border: 2px solid rgba(255,255,255,0.55); border-radius: 50%;
    background: rgba(255,255,255,0.14); color: rgba(255,255,255,0.9);
    font: bold 0.95rem system-ui, sans-serif; user-select: none; -webkit-user-select: none;
    touch-action: none; text-shadow: 0 1px 2px rgba(0,0,0,0.7); cursor: pointer;
  }
  .xa-controls .xa-btn:active { background: rgba(255,255,255,0.34); }

  /* D-pad (bottom-left): single draggable area, direction follows the finger */
  .xa-dpad {
    position: absolute; left: calc(0.8rem + env(safe-area-inset-left)); bottom: calc(1rem + env(safe-area-inset-bottom));
    width: 8rem; height: 8rem; pointer-events: auto;
    border: 2px solid rgba(255,255,255,0.4); border-radius: 50%;
    background: rgba(255,255,255,0.08); touch-action: none;
  }
  .xa-dpad-arrow {
    position: absolute; color: rgba(255,255,255,0.75);
    font-size: 1.4rem; text-shadow: 0 1px 2px rgba(0,0,0,0.7);
    pointer-events: none; user-select: none; -webkit-user-select: none;
  }
  .xa-up    { left: 50%; top: 0.4rem; transform: translateX(-50%); }
  .xa-left  { left: 0.5rem; top: 50%; transform: translateY(-50%); }
  .xa-down  { left: 50%; bottom: 0.4rem; transform: translateX(-50%); }
  .xa-right { right: 0.5rem; top: 50%; transform: translateY(-50%); }

  /* Actions (bottom-right): jump (big) + fire, with a gap between them */
  .xa-actions .xa-btn { width: 3.6rem; height: 3.6rem; }
  .xa-jump { right: calc(1.2rem + env(safe-area-inset-right)); bottom: calc(1.2rem + env(safe-area-inset-bottom)); width: 4.6rem !important; height: 4.6rem !important; }
  .xa-fire { right: calc(6.8rem + env(safe-area-inset-right)); bottom: calc(2.4rem + env(safe-area-inset-bottom)); font-size: 0.7rem !important; }

  /* small landscape phones: shrink the pad and buttons so they don't cover the play area */
  @media (max-height: 420px) {
    .xa-dpad { width: 6.5rem; height: 6.5rem; }
    .xa-jump { width: 3.8rem !important; height: 3.8rem !important; }
    .xa-actions .xa-btn.xa-fire { width: 3rem; height: 3rem; right: calc(5.6rem + env(safe-area-inset-right)); }
  }

  /* Back (top-right) */
  .xa-back { right: 0.8rem; top: 0.8rem; width: 2.6rem; height: 2.6rem; font-size: 1.1rem !important; }
</style>
