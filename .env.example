# Modo online cooperativo (hasta 4 jugadores).
# Copiá este archivo a `.env` y completá los valores. Sin las dos variables, el juego
# funciona igual pero el botón ONLINE avisa que este build no tiene servidor.
#
# URL del backend (xa-backend), sin barra final.
#   Local:  http://127.0.0.1:8787
#   Online: https://tu-servidor.example.com
PUBLIC_XA_BACKEND_URL=http://127.0.0.1:8787

# El mismo valor que `GAME_TOKEN` en el `.env` del backend (`npm run token` genera uno).
# Al ser una variable PUBLIC_* viaja en el bundle: sirve para que los bots no encuentren
# el servidor, no es un secreto fuerte.
PUBLIC_XA_BACKEND_TOKEN=el-mismo-token-del-backend
